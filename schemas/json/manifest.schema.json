{
  "$defs": {
    "ArmingConfig": {
      "properties": {
        "form": {
          "default": "interactive",
          "enum": [
            "interactive",
            "standing"
          ],
          "title": "Form",
          "type": "string"
        },
        "idp_ref": {
          "default": "client",
          "title": "Idp Ref",
          "type": "string"
        },
        "ttl_minutes": {
          "default": 60,
          "title": "Ttl Minutes",
          "type": "integer"
        }
      },
      "title": "ArmingConfig",
      "type": "object"
    },
    "AuditConfig": {
      "description": "The audit store's location and retention (\u00a74.2.6).\n\nA separate store *beside* Bronze, never inside it. `AuditRecord`s are\nproduced by `normalize`, i.e. after `ingest`, so writing them into a Bronze\npartition would be a post-`ingest` write to Bronze (P10) and would leave that\npartition without a stable content hash, collapsing \u00a74.2.5 layer 3.\n\nThere is no `format` key here, unlike `BronzeConfig`. The absence is\ndeliberate: \u00a74.2.1 pins Bronze's substrate because \u00a74.2.1's three arguments\nare about Bronze, and the audit store's format is an internal kernel matter\nthat no manifest has a reason to name. A key that cannot vary is worth\nexposing only where a reader would otherwise expect variance, and \u00a77.1 never\ninvited it here.",
      "properties": {
        "location": {
          "description": "A path abstraction, resolved the same way as bronze.location (\u00a74.2.2). Parallel to Bronze, never a path inside it.",
          "title": "Location",
          "type": "string"
        },
        "retention_days": {
          "description": "Mandatory, and floored at bronze.retention_days (\u00a74.2.6)",
          "exclusiveMinimum": 0,
          "title": "Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "retention_days"
      ],
      "title": "AuditConfig",
      "type": "object"
    },
    "BronzeConfig": {
      "properties": {
        "location": {
          "description": "A path abstraction, not a local path (\u00a74.2.2). Resolved by kernel.storage.resolve_location; local FS, S3 and Azure Blob are equally valid, though only local is implemented in this build.",
          "title": "Location",
          "type": "string"
        },
        "format": {
          "const": "parquet",
          "default": "parquet",
          "title": "Format",
          "type": "string"
        },
        "partition_by": {
          "default": "batch_id",
          "title": "Partition By",
          "type": "string"
        },
        "retention_days": {
          "description": "Mandatory \u2014 preflight fails if unset",
          "exclusiveMinimum": 0,
          "title": "Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "location",
        "retention_days"
      ],
      "title": "BronzeConfig",
      "type": "object"
    },
    "EgressConfig": {
      "properties": {
        "evidence_only": {
          "default": true,
          "title": "Evidence Only",
          "type": "boolean"
        },
        "k_anonymity_min": {
          "default": 5,
          "title": "K Anonymity Min",
          "type": "integer"
        }
      },
      "title": "EgressConfig",
      "type": "object"
    },
    "GovernanceConfig": {
      "description": "Declarations \u00a76.2.2 requires be *present*, not proven (\u00a76.2.2, 0.5.4).\n\nBoth fields below back **declaration-class** checks: preflight verifies that\na commitment was made and does not test whether it holds. That is not a\nweakness to be fixed later by validating the strings \u2014 a DPA reference is a\npointer into contract work that lives outside this repository, and a restore\npoint cannot be exercised by a tool holding no standing access (P9). What\nthe check buys is that the commitment cannot be *absent* and unnoticed.",
      "properties": {
        "dpa_ref": {
          "description": "Reference to the executed DPA/KV\u0130S for this engagement \u2014 a contract id or document reference, never the document itself (\u00a72.1 L1).",
          "minLength": 1,
          "title": "Dpa Ref",
          "type": "string"
        },
        "restore_point": {
          "description": "The client-side restore point or snapshot this run can be rolled back to (\u00a76.2.2 capacity). Declared by the client; its existence is not verified by the Harness.",
          "minLength": 1,
          "title": "Restore Point",
          "type": "string"
        }
      },
      "required": [
        "dpa_ref",
        "restore_point"
      ],
      "title": "GovernanceConfig",
      "type": "object"
    },
    "PreflightConfig": {
      "properties": {
        "sample_limit": {
          "default": 200,
          "exclusiveMinimum": 0,
          "title": "Sample Limit",
          "type": "integer"
        },
        "freshness_window_hours": {
          "default": 48,
          "exclusiveMinimum": 0,
          "title": "Freshness Window Hours",
          "type": "integer"
        },
        "row_count_bounds": {
          "$ref": "#/$defs/RowCountBounds"
        },
        "estimated_run_minutes": {
          "default": 45,
          "exclusiveMinimum": 0,
          "title": "Estimated Run Minutes",
          "type": "integer"
        },
        "arming": {
          "$ref": "#/$defs/ArmingConfig"
        }
      },
      "title": "PreflightConfig",
      "type": "object"
    },
    "RowCountBounds": {
      "description": "Declared row count envelope for the bound source (\u00a76.2.2).\n\nTyped rather than left as `dict[str, int]`, which accepted `{}` and\n`{\"foo\": 5}` and made the volume check a comparison against nothing. A\nblocker that silently has no bounds to compare against is the failure mode\nthis repo keeps finding, so the bounds are a model with a validator.",
      "properties": {
        "min": {
          "minimum": 0,
          "title": "Min",
          "type": "integer"
        },
        "max": {
          "exclusiveMinimum": 0,
          "title": "Max",
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max"
      ],
      "title": "RowCountBounds",
      "type": "object"
    },
    "SourceBinding": {
      "properties": {
        "kind": {
          "enum": [
            "database",
            "file"
          ],
          "title": "Kind",
          "type": "string"
        },
        "dialect": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dialect"
        },
        "connection_ref": {
          "title": "Connection Ref",
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "posture": {
          "default": "replica",
          "enum": [
            "replica",
            "snapshot",
            "primary"
          ],
          "title": "Posture",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "connection_ref",
        "objects"
      ],
      "title": "SourceBinding",
      "type": "object"
    },
    "SourceConfig": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/SourceBinding"
        },
        "format": {
          "title": "Format",
          "type": "string"
        },
        "encoding": {
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "locale": {
          "default": "tr-TR",
          "title": "Locale",
          "type": "string"
        },
        "column_map": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Column Map",
          "type": "object"
        }
      },
      "required": [
        "name",
        "binding",
        "format",
        "column_map"
      ],
      "title": "SourceConfig",
      "type": "object"
    },
    "TargetConfig": {
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "connection_ref": {
          "title": "Connection Ref",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "string"
        },
        "staging": {
          "title": "Staging",
          "type": "string"
        },
        "quarantine": {
          "title": "Quarantine",
          "type": "string"
        },
        "retention_days": {
          "default": 90,
          "exclusiveMinimum": 0,
          "title": "Retention Days",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "connection_ref",
        "canonical",
        "staging",
        "quarantine"
      ],
      "title": "TargetConfig",
      "type": "object"
    }
  },
  "properties": {
    "engagement": {
      "title": "Engagement",
      "type": "string"
    },
    "tenant": {
      "title": "Tenant",
      "type": "string"
    },
    "sector": {
      "title": "Sector",
      "type": "string"
    },
    "canonical_schema": {
      "title": "Canonical Schema",
      "type": "string"
    },
    "mode": {
      "default": "execute",
      "enum": [
        "discover",
        "execute"
      ],
      "title": "Mode",
      "type": "string"
    },
    "cadence": {
      "default": "one_shot",
      "enum": [
        "one_shot",
        "continuous"
      ],
      "title": "Cadence",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/SourceConfig"
      },
      "title": "Sources",
      "type": "array"
    },
    "bronze": {
      "$ref": "#/$defs/BronzeConfig"
    },
    "audit": {
      "$ref": "#/$defs/AuditConfig"
    },
    "target": {
      "$ref": "#/$defs/TargetConfig"
    },
    "governance": {
      "$ref": "#/$defs/GovernanceConfig"
    },
    "preflight": {
      "$ref": "#/$defs/PreflightConfig"
    },
    "packs": {
      "items": {
        "type": "string"
      },
      "title": "Packs",
      "type": "array"
    },
    "external_references": {
      "items": {
        "type": "string"
      },
      "title": "External References",
      "type": "array"
    },
    "egress": {
      "$ref": "#/$defs/EgressConfig"
    }
  },
  "required": [
    "engagement",
    "tenant",
    "sector",
    "canonical_schema",
    "sources",
    "bronze",
    "audit",
    "target",
    "governance"
  ],
  "title": "Manifest",
  "type": "object"
}
